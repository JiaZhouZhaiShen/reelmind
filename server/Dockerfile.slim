# syntax=docker/dockerfile:1
# =============================================================================
# ReelMind Server Slim — lightweight server without GPU / AI dependencies
# AI operations are proxied to the reelmind-ai container via HTTP.
# 前端 dist 烘入镜像（/web/dist），部署无需手动 npm run build。
# =============================================================================
# ── Stage 1: build frontend ─────────────────────────────────────────────────
FROM node:20-alpine AS web-build
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ .
RUN npm run build

# ── Stage 2: server runtime ─────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# ── System dependencies ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ─────────────────────────────────────────────────────
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# ── Application ─────────────────────────────────────────────────────────────
COPY server/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

COPY server/ .

# ── Frontend (baked from stage 1; main.py frontend_candidates 含 /web/dist) ──
COPY --from=web-build /build/dist /web/dist

EXPOSE 2588

ENTRYPOINT ["/usr/bin/tini", "--", "/docker-entrypoint.sh"]
