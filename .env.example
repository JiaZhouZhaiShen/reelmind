# =============================================================================
# ReelMind 环境配置 ｜ Environment Configuration
# =============================================================================
# 将此文件另存为 .env 并根据你的部署环境修改。
# Copy this file to .env and adjust values for your deployment.
#
# Synology 典型路径示例：
#   数据目录:  /volume1/docker/reelmind/data
#   外部媒体:  /volume1/video/footage
#   缓存目录:  /volume1/docker/reelmind/cache
# =============================================================================


# ── 调试 ｜ Debug ──────────────────────────────────────────────────────────
DEBUG=false                         # 开启后输出详细 SQL 日志（生产环境保持 false）


# ── 数据库 ｜ PostgreSQL (pgvector) ───────────────────────────────────────
# 🔴🔴🔴 安全警告 ｜ SECURITY WARNING 🔴🔴🔴
# 以下密码为开发默认值。生产环境必须替换为强密码！
# 生成强密码: python -c "import secrets; print(secrets.token_urlsafe(24))"
# 🔴🔴🔴 安全警告 ｜ SECURITY WARNING 🔴🔴🔴
DB_HOST=postgres                    # Docker Compose 中设为 postgres（服务名）
DB_PORT=5432
DB_USER=reelmind
DB_PASSWORD=change-me               # 🔴 生产环境必须替换为强密码！
DB_NAME=reelmind

# 连接池 ｜ Connection Pool
DB_POOL_SIZE=5                      # 连接池大小（Worker 建议 2，Server 建议 5）
DB_POOL_OVERFLOW=3                  # 最大溢出连接数
DB_POOL_TIMEOUT=30                  # 等待连接超时秒数
DB_POOL_RECYCLE=1800                # 连接回收周期（秒），NAS 低内存可减小到 600

# PostgreSQL 内存调优（Synology Intel NAS 建议值）
PG_SHARED_BUFFERS=256MB             # 共享缓冲区，NAS 4GB RAM 可设为 512MB
PG_EFFECTIVE_CACHE=768MB            # 有效缓存大小
PG_WORK_MEM=16MB                    # 排序/哈希操作内存
PG_MAINT_WORK_MEM=64MB              # 维护操作（VACUUM 等）内存
PG_MEM_LIMIT=1g                     # 容器内存上限
PG_MEM_RESERVE=256M                 # 保留内存


# ── Redis / Celery 消息队列 ──────────────────────────────────────────────
REDIS_HOST=redis                    # Docker Compose 中设为 redis（服务名）
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=256mb               # Redis 最大内存
REDIS_MEM_LIMIT=512m                # 容器内存上限
REDIS_MEM_RESERVE=64M

# Redis 数据持久化路径（Docker Compose 映射）
REDIS_DATA_ROOT=./data/redis        # Synology: /volume1/docker/reelmind/redis


# ── ReelMind 数据存储 ────────────────────────────────────────────────────
# 根目录：包含配置、上传、缓存等
REELMIND_DATA_ROOT=./data/reelmind  # Synology: /volume1/docker/reelmind/data

# 外部媒体库挂载路径（只读）
EXTERNAL_MEDIA_DIR=./media          # Synology: /volume1/video/footage

# 数据库持久化路径
PGDATA_ROOT=./data/postgres         # Synology: /volume1/docker/reelmind/postgres


# ── 服务器 ｜ Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=2588
PORT_MAP=0.0.0.0:2588               # 宿主机端口映射

SERVER_MEM_LIMIT=512m               # Server 容器内存上限（NAS 4GB 建议 512m）
SERVER_MEM_RESERVE=128M
SERVER_CPU_LIMIT=1.0                # CPU 核数限制


# ── Worker（Celery 后台任务） ─────────────────────────────────────────────
CELERY_CONCURRENCY=1                # 并发 Worker 数（NAS 建议 1，高性能可到 2）
CELERY_LOGLEVEL=info                # 日志级别: debug | info | warning | error
CELERY_MAX_TASKS=10                 # 每个 Worker 子进程最大任务数（防内存泄漏）
CELERY_PREFETCH=1                   # 预取倍数（低内存设为 1）

WORKER_MEM_LIMIT=1g                 # Worker 容器内存上限（AI 任务需要更多内存）
WORKER_MEM_RESERVE=256M
WORKER_CPU_LIMIT=2.0
WORKER_DB_POOL_SIZE=2               # Worker 专用连接池（2-3 即可）


# ── 视频处理 ｜ Video Transcoding ────────────────────────────────────────
PROXY_VIDEO_BITRATE=1M              # 代理视频码率（NAS 建议 1M，高性能可到 2M）
PROXY_VIDEO_MAX_WIDTH=960           # 代理视频最大宽度（NAS 建议 960，高清可到 1280）
THUMBNAIL_QUALITY=80                # 缩略图质量 1-100


# ── AI 功能（默认关闭，按需开启） ────────────────────────────────────────
# ⚠ 开启 AI 功能会显著增加 CPU/内存负载！
# 开启前建议确保 NAS 至少有 8GB 可用内存和空闲 CPU 核心。

# 语音转文字（Whisper）
ENABLE_WHISPER=false                # 设为 true 启用
WHISPER_MODEL=tiny                  # 模型大小: tiny | base | small | medium | large
                                    # NAS 建议 tiny（速度最快，内存 ~1GB）
                                    # large 需要 ~10GB 内存，不推荐 NAS

# 视觉语义搜索（CLIP）
ENABLE_CLIP=false                   # 设为 true 启用（需要额外 ~2GB 内存）
# CLIP_MODEL=ViT-B/32               # 模型选择（默认 ViT-B/32）

# 人脸检测
ENABLE_FACE_DETECT=false            # 设为 true 启用


# ── 硬件加速（Intel QuickSync） ──────────────────────────────────────────
# 仅 Synology 带 Intel GPU（如 J4125、N5095、N100 等）可启用
ENABLE_HW_ACCEL=false               # 设为 true 启用 Intel QSV 硬件转码
HW_ACCEL_DEVICE=/dev/dri/renderD128 # Intel GPU 设备路径（DSM 7.x 默认路径）

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- AI / ML Settings ---
WHISPER_MODEL=large-v3
CLIP_MODEL=ViT-B-16
ENABLE_WHISPER=true
ENABLE_CLIP=true
ENABLE_FACE_DETECT=false
# HuggingFace token for pyannote speaker diarization
HUGGINGFACE_TOKEN=
# 🔴🔴🔴 安全警告 ｜ SECURITY WARNING 🔴🔴🔴
# JWT 签名密钥 — 开发默认值可运行但极不安全！
# 生产环境必须替换！任何人持有此密钥即可伪造登录令牌。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 🔴🔴🔴 安全警告 ｜ SECURITY WARNING 🔴🔴🔴
JWT_SECRET=change-me                # 🔴 生产环境必须替换为随机强密钥！
# AI 容器内部地址（Docker Compose 自动设定，无需手动修改）
# AI_SERVICE_URL=http://reelmind-ai:2589
# AI 容器资源限制
# AI_MEM_LIMIT=4g
# AI_CPU_LIMIT=4.0
# AI_MEM_RESERVE=2g

# ---- GHCR 镜像覆盖（可选）----
# 不设置时使用本地构建（reelmind/*:latest），设置后 docker compose pull/up 从 ghcr 拉取：
# REELMIND_SERVER_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-server:v9.26.0901
# REELMIND_ORCHESTRATOR_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-orchestrator:v9.26.0901
# REELMIND_AI_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-ai:v9.26.0901
# REELMIND_NGINX_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-nginx:v9.26.0901

# --- GHCR 镜像覆盖（可选）---
# 默认不设置 = 本地 docker compose build（镜像名 reelmind/*:latest）
# 从 GitHub Container Registry 拉取示例（需先 cd web && npm install && npm run build）：
# REELMIND_SERVER_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-server:v9.26.0901
# REELMIND_ORCHESTRATOR_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-orchestrator:v9.26.0901
# REELMIND_AI_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-ai:v9.26.0901
# REELMIND_NGINX_IMAGE=ghcr.io/jiazhouzhaishen/reelmind-nginx:v9.26.0901
# 然后执行：docker compose pull && docker compose up -d
